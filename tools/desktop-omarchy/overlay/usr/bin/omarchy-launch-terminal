#!/bin/bash
# DroidHost shadow of upstream omarchy's omarchy-launch-terminal. Upstream runs
# `xdg-terminal-exec` (the XDG terminal picker), which the proot guest does not ship; alacritty
# is the terminal installed via seeds.txt. Launch it directly through the uwsm-app shim so
# SUPER+RETURN opens a terminal instead of failing on the missing xdg-terminal-exec.
cwd="$(omarchy-cmd-terminal-cwd 2>/dev/null || printf '%s' "$HOME")"
exec setsid uwsm-app -- alacritty --working-directory "$cwd" "$@"

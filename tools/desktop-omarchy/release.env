# (the DE is not pinned into the APK yet), SIZE 0.
DESKTOP_OMARCHY_REPO=linuszz/DroidHost-Components
DESKTOP_OMARCHY_TAG=desktop-omarchy-r1
DESKTOP_OMARCHY_SHA256=
DESKTOP_OMARCHY_SIZE=0
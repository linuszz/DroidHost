 #include "path/binding.h"
 #include "arch.h"
 
+/**
+ * Copy the auxiliary vectors of the current program into the buffer given
+ * by the tracee, as PR_GET_AUXV(2) does.  The kernel answers with the
+ * vectors of the program it really executed -- under PRoot's loader that is
+ * the loader itself -- while the guest expects its own ones.
+ */
+static int translate_get_auxv(Tracee *tracee)
+{
+	unsigned char raw[512];
+	word_t buffer;
+	word_t size;
+	size_t word;
+	size_t length;
+	size_t offset;
+
+	buffer = peek_reg(tracee, CURRENT, SYSARG_2);
+	size = peek_reg(tracee, CURRENT, SYSARG_3);
+
+	if (tracee->auxv_address == 0)
+		return 0;
+
+	word = sizeof_word(tracee);
+	if (word > sizeof(raw))
+		return 0;
+
+	/* Read the vectors entry by entry: the last one ends the array, and
+	 * reading further would go past the top of the stack.  */
+	length = 0;
+	for (offset = 0; offset + 2 * word <= sizeof(raw); offset += 2 * word) {
+		word_t type;
+
+		if (read_data(tracee, raw + offset, tracee->auxv_address + offset, 2 * word) < 0)
+			return 0;
+
+		type = (word == sizeof(word_t))
+			? ((word_t *) raw)[offset / word]
+			: ((uint32_t *) raw)[offset / word];
+		if (type == AT_NULL) {
+			length = offset + 2 * word;
+			break;
+		}
+	}
+
+	if (length == 0)
+		return 0;
+
+	/* A too small buffer is reported as the length the caller needs.  */
+	if (length > size) {
+		set_sysnum(tracee, PR_void);
+		poke_reg(tracee, SYSARG_RESULT, (word_t) length);
+		return 0;
+	}
+
+	if (write_data(tracee, buffer, raw, length) < 0)
+		return 0;
+
+	set_sysnum(tracee, PR_void);
+	poke_reg(tracee, SYSARG_RESULT, (word_t) length);
+	return 0;
+}

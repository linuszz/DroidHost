 /**
+ * Whether @path designates the executable link of @tracee itself, that is
+ * /proc/self/exe, /proc/thread-self/exe, or /proc/<its own pid>/exe.
+ */
+static bool is_tracee_exe_link(const Tracee *tracee, const char *path)
+{
+	const char *head = "/proc/";
+	const char *entry;
+	const char *slash;
+	char pid[32];
+	char own[32];
+	size_t length;
+
+	if (strncmp(path, head, strlen(head)) != 0)
+		return false;
+
+	entry = path + strlen(head);
+	slash = strchr(entry, '/');
+	if (slash == NULL || strcmp(slash, "/exe") != 0)
+		return false;
+
+	length = slash - entry;
+	if (length == 0 || length >= sizeof(pid))
+		return false;
+
+	memcpy(pid, entry, length);
+	pid[length] = '\0';
+
+	if (strcmp(pid, "self") == 0 || strcmp(pid, "thread-self") == 0)
+		return true;
+
+	if (snprintf(own, sizeof(own), "%d", (int) tracee->pid) < 0)
+		return false;
+
+	return strcmp(pid, own) == 0;
+}

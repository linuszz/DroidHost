# Pinned from the desktop-hyprland release in DroidHost-Components (desktop-hyprland.tar.zst).
# Empty until the first Hyprland pack is published: buildConfigPack returns null while SHA256 is
# empty, so the picker does not offer Hyprland before then. The integrator fills these on publish.
DESKTOP_HYPR_REPO=linuszz/DroidHost-Components
DESKTOP_HYPR_TAG=
DESKTOP_HYPR_SHA256=
DESKTOP_HYPR_SIZE=0